erDiagram
  personas ||--o{ contactos : tiene
  personas ||--o{ domicilios : tiene
  personas ||--o| datos_academicos : tiene
  personas ||--o| alumnos : "es"
  personas ||--o| instructores : "es"
  personas ||--o| responsables_pago : "es"
  personas ||--o| usuarios : "accede como"
  usuarios ||--o{ usuario_roles : tiene
  roles ||--o{ usuario_roles : "se asigna en"
  sucursales |o--o{ usuario_roles : "en (null = global)"
  roles ||--o{ rol_permisos : otorga
  permisos ||--o{ rol_permisos : "incluido en"
  sucursales ||--o{ alumnos : inscribe
  alumnos ||--o{ alumno_responsable : "lo paga"
  responsables_pago ||--o{ alumno_responsable : paga
  usuarios ||--o{ sesiones : abre
  usuario_roles |o--o{ sesiones : "trabaja con"
  sucursales ||--o{ folios : numera
  personas {
    int id PK
    string nombre
    string apellido_paterno
    string apellido_materno
    date fecha_nacimiento
    string sexo
    string curp UK "obligatoria para alumnos"
    string foto "obligatoria para alumnos"
  }
  contactos {
    int id PK
    int persona_id FK
    enum tipo "telefono|email|whatsapp"
    string valor
    bool principal
  }
  domicilios {
    int id PK
    int persona_id FK
    string calle
    string numero
    string colonia
    string cp
    string municipio
    string estado
  }
  datos_academicos {
    int id PK
    int persona_id FK
    string escuela
    string nivel
  }
  alumnos {
    int id PK
    string matricula UK "CENT-26-0001"
    int persona_id FK
    int sucursal_id FK
    date fecha_alta
    enum estado "activo|baja|suspendido"
    string codigo_qr UK
  }
  instructores {
    int id PK
    int persona_id FK
    date fecha_ingreso
  }
  responsables_pago {
    int id PK
    int persona_id FK
  }
  alumno_responsable {
    int alumno_id PK,FK
    int responsable_id PK,FK
    string parentesco
    date vigente_desde
    date vigente_hasta
  }
  usuarios {
    int id PK
    int persona_id FK
    string email UK
    string password_hash
    bool activo
    int intentos_fallidos
    datetime bloqueado_hasta
  }
  roles {
    int id PK
    string nombre UK
    string descripcion
    int nivel "1 a 5"
    enum alcance "global|sucursal|propio"
  }
  usuario_roles {
    int id PK
    int usuario_id FK
    int rol_id FK
    int sucursal_id FK "null = global"
    bool activo
  }
  permisos {
    int id PK
    string clave UK "alumnos.crear, pagos.registrar..."
    string modulo
    string descripcion
    int nivel_minimo
  }
  rol_permisos {
    int rol_id PK,FK
    int permiso_id PK,FK
  }
  sucursales {
    int id PK
    string clave UK "4 letras"
    string nombre
    int domicilio_id FK
    bool activa
  }
  sesiones {
    int id PK
    int usuario_id FK
    int usuario_rol_id FK "rol elegido"
    string token_hash UK "SHA-256"
    string ip
    datetime creada
    datetime ultima_actividad
    datetime revocada
  }
  folios {
    int sucursal_id PK,FK
    enum tipo PK "matricula|recibo"
    int anio PK
    int ultimo
  }
