    int alumno_id FK
    int horario_id FK
    int sucursal_id FK
    datetime fecha_hora
    enum metodo "qr|manual"
    int registrado_por FK
    bool validada_instructor }
  alumno_grados { int id PK
    int alumno_id FK
    int grado_id FK
    date fecha_obtencion
    enum origen "ubicacion|examen|migracion"
    int solicitud_examen_id FK
    int evaluado_por FK }
  pases_dia { int id PK
    int persona_id FK
    int sucursal_id FK
    int horario_id FK
    date fecha
    int pago_detalle_id FK }
  accesos_rechazados { int id PK
    int alumno_id FK
