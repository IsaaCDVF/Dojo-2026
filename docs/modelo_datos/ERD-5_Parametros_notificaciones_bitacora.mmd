erDiagram
  parametros ||--o{ parametro_valores : "historial de valores"
  sucursales |o--o{ parametro_valores : "override (null = global)"
  disciplinas |o--o{ parametro_valores : "por disciplina"
  grados |o--o{ parametro_valores : "por grado"
  usuarios ||--o{ parametro_valores : modifica
  plantillas_notificacion ||--o{ notificaciones : usa
  personas ||--o{ notificaciones : recibe
  usuarios ||--o{ bitacora : "hace el cambio"
  sucursales |o--o{ bitacora : en
  parametros { int id PK
    string clave UK
    string descripcion
    enum tipo_dato "entero|decimal|porcentaje|dias|minutos|texto"
    string unidad }
  parametro_valores { int id PK
    int parametro_id FK
    int sucursal_id FK
    int disciplina_id FK
    int grado_id FK
    string valor
    datetime vigente_desde
    datetime vigente_hasta
    int modificado_por FK }
  plantillas_notificacion { int id PK
    string evento
    enum canal "email|whatsapp|sms|app"
    string asunto
    text cuerpo }
  notificaciones { int id PK
    int persona_id FK
    int plantilla_id FK
    text mensaje "texto final enviado"
    datetime fecha_programada
    datetime fecha_envio
    enum estado "programada|enviada|fallida"
    string referencia_tabla
    int referencia_id }
  bitacora { bigint id PK
    int usuario_id FK
    int sucursal_id FK
    datetime fecha_hora
    enum accion "alta|cambio|baja"
    string tabla
    int registro_id
    string campo
    text valor_anterior
    text valor_nuevo
    string ip }
