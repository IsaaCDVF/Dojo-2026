  responsables_pago ||--o{ pagos : realiza
  pagos ||--|{ pago_detalles : contiene
  alumnos ||--o{ pago_detalles : "a nombre de"
  conceptos ||--o{ pago_detalles : cobra
  promociones |o--o{ pago_detalles : aplica
  promociones ||--o{ promocion_conceptos : descuenta
  conceptos ||--o{ promocion_conceptos : en
