# Copiar como .env (no se sube a GitHub) y poner las contrasenas reales.
# Lo lee docker-compose.yml. DB_PASS debe ser igual a la de web-code/api/.env
DB_ROOT_PASS=cambiar_root
DB_PASS=cambiar_esta_contrasena
DB_NAME=dojo
DB_USER=dojo
# Puerto de tu computadora para TablePlus (dentro de Docker siempre es 3306)
DB_HOST_PORT=3307
APP_TZ=America/Mexico_City
